<style>
  .global-emi-container {
    box-sizing: border-box;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }
  
  .global-emi-card {
    background: #ffffff;
    width: 100%;
    max-width: 480px;
    margin: 20px auto;
    border-radius: 16px;
    box-shadow: 0 10px 25px rgba(13, 71, 161, 0.15);
    border: 2px solid #1976d2;
    overflow: hidden;
  }
  
  .global-emi-header {
    background: linear-gradient(135deg, #0d47a1, #1976d2);
    color: #ffffff;
    padding: 24px 20px;
    text-align: center;
  }
  
  .global-emi-header h2 {
    margin: 0;
    font-size: 24px;
    font-weight: 700;
  }
  
  .global-emi-header p {
    margin: 6px 0 0 0;
    font-size: 14px;
    opacity: 0.9;
  }
  
  .global-emi-body {
    padding: 24px 20px;
  }
  
  .input-group {
    margin-bottom: 18px;
  }
  
  .input-group label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: #0d47a1;
    margin-bottom: 6px;
  }
  
  .input-flex-wrapper {
    display: flex;
    gap: 8px;
  }
  
  .currency-select {
    padding: 12px;
    font-size: 15px;
    border: 2px solid #bbdefb;
    border-radius: 8px;
    outline: none;
    background-color: #e3f2fd;
    color: #0d47a1;
    font-weight: bold;
    cursor: pointer;
  }
  
  .global-input {
    width: 100%;
    padding: 12px 14px;
    font-size: 16px;
    border: 2px solid #bbdefb;
    border-radius: 8px;
    outline: none;
    color: #0d47a1;
    font-weight: 600;
  }
  
  .global-input:focus, .currency-select:focus {
    border-color: #1976d2;
  }
  
  .tenure-flex {
    display: flex;
    gap: 10px;
  }
  
  .tenure-box {
    flex: 1;
  }

  .result-box {
    margin-top: 22px;
    background: #e3f2fd;
    border-radius: 12px;
    padding: 18px;
    border: 1px solid #90caf9;
  }
  
  .result-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 0;
    border-bottom: 1px dashed #90caf9;
  }
  
  .result-item:last-child {
    border-bottom: none;
  }
  
  .result-label {
    font-size: 13px;
    color: #1565c0;
    font-weight: 600;
  }
  
  .result-value {
    font-size: 15px;
    color: #0d47a1;
    font-weight: 700;
  }
  
  .highlight-emi {
    background: #1976d2;
    color: #ffffff;
    padding: 14px;
    border-radius: 8px;
    margin-bottom: 12px;
  }
  
  .highlight-emi .result-label {
    color: #bbdefb;
  }
  
  .highlight-emi .result-value {
    color: #ffffff;
    font-size: 21px;
  }

  .progress-bar-container {
    margin-top: 15px;
    background: #bbdefb;
    border-radius: 6px;
    height: 12px;
    display: flex;
    overflow: hidden;
  }
  .progress-principal {
    background: #0d47a1;
    height: 100%;
    transition: width 0.3s ease;
  }
  .progress-interest {
    background: #42a5f5;
    height: 100%;
    transition: width 0.3s ease;
  }
  .legend-box {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    margin-top: 5px;
    color: #0d47a1;
    font-weight: 600;
  }
</style>

<div class="global-emi-container">
  <div class="global-emi-card">
    <div class="global-emi-header">
      <h2>Global EMI Calculator</h2>
      <p>Instant & Professional Loan Estimator</p>
    </div>
    
    <div class="global-emi-body">
      <!-- లోన్ అమౌంట్ -->
      <div class="input-group">
        <label>Loan Amount</label>
        <div class="input-flex-wrapper">
          <select class="currency-select" id="currencySymbol" onchange="calculateGlobalEMI()">
            <option value="$">$ (USD)</option>
            <option value="€">€ (EUR)</option>
            <option value="£">£ (GBP)</option>
            <option selected value="₹">₹ (INR)</option>
            <option value="A$">A$ (AUD)</option>
            <option value="C$">C$ (CAD)</option>
            <option value="AED">AED</option>
          </select>
          <input class="global-input" id="loanAmount" type="number" value="1000000" oninput="calculateGlobalEMI()" />
        </div>
      </div>

      <!-- వడ్డీ రేటు -->
      <div class="input-group">
        <label>Annual Interest Rate (%)</label>
        <input class="global-input" id="interestRate" type="number" step="0.1" value="8.5" oninput="calculateGlobalEMI()" />
      </div>

      <!-- కాలపరిమితి (సంవత్సరాలు మరియు నెలలు) -->
      <div class="input-group">
        <label>Loan Tenure</label>
        <div class="tenure-flex">
          <div class="tenure-box">
            <input class="global-input" id="tenureYears" type="number" min="0" value="5" placeholder="Years" oninput="calculateGlobalEMI()" />
            <span style="font-size: 11px; color: #1565c0; font-weight: 600;">Years</span>
          </div>
          <div class="tenure-box">
            <input class="global-input" id="tenureMonths" type="number" min="0" max="11" value="0" placeholder="Months" oninput="calculateGlobalEMI()" />
            <span style="font-size: 11px; color: #1565c0; font-weight: 600;">Months</span>
          </div>
        </div>
      </div>

      <!-- ప్రాసెసింగ్ ఫీజు -->
      <div class="input-group">
        <label>Processing Fee (%) [Optional]</label>
        <input class="global-input" id="processingFee" type="number" step="0.1" value="1" oninput="calculateGlobalEMI()" />
      </div>

      <!-- ఫలితాల బాక్స్ -->
      <div class="result-box">
        <div class="result-item highlight-emi">
          <span class="result-label">Monthly Payment (EMI):</span>
          <span class="result-value" id="monthlyEMI">0</span>
        </div>
        <div class="result-item">
          <span class="result-label">Principal Amount:</span>
          <span class="result-value" id="principalAmount">0</span>
        </div>
        <div class="result-item">
          <span class="result-label">Total Interest Payable:</span>
          <span class="result-value" id="totalInterest">0</span>
        </div>
        <div class="result-item">
          <span class="result-label">Processing Fee:</span>
          <span class="result-value" id="procFeeAmount">0</span>
        </div>
        <div class="result-item">
          <span class="result-label">Total Payment:</span>
          <span class="result-value" id="totalPayment">0</span>
        </div>

        <div class="progress-bar-container">
          <div class="progress-principal" id="barPrincipal" style="width: 50%;"></div>
          <div class="progress-interest" id="barInterest" style="width: 50%;"></div>
        </div>
        <div class="legend-box">
          <span>■ Principal</span>
          <span>■ Interest</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculateGlobalEMI() {
    const p = parseFloat(document.getElementById('loanAmount').value);
    const rAnnual = parseFloat(document.getElementById('interestRate').value);
    const years = parseInt(document.getElementById('tenureYears').value) || 0;
    const months = parseInt(document.getElementById('tenureMonths').value) || 0;
    const feePercent = parseFloat(document.getElementById('processingFee').value) || 0;
    const curr = document.getElementById('currencySymbol').value;

    const totalMonths = (years * 12) + months;

    if (isNaN(p) || isNaN(rAnnual) || p <= 0 || rAnnual < 0 || totalMonths <= 0) {
      return;
    }

    const r = rAnnual / 12 / 100;
    const n = totalMonths;

    let emi = 0;
    if (r === 0) {
      emi = p / n;
    } else {
      emi = (p * r * Math.pow(1 + r, n)) / (Math.pow(1 + r, n) - 1);
    }

    const totalPay = emi * n;
    const totalInt = totalPay - p;
    const procFeeVal = (p * feePercent) / 100;

    const formatNumber = (num) => {
      return curr + ' ' + Math.round(num).toLocaleString('en-IN');
    };

    document.getElementById('monthlyEMI').innerText = formatNumber(emi);
    document.getElementById('principalAmount').innerText = formatNumber(p);
    document.getElementById('totalInterest').innerText = formatNumber(totalInt);
    document.getElementById('procFeeAmount').innerText = formatNumber(procFeeVal);
    document.getElementById('totalPayment').innerText = formatNumber(totalPay);

    const principalPercent = (p / totalPay) * 100;
    const interestPercent = (totalInt / totalPay) * 100;
    document.getElementById('barPrincipal').style.width = principalPercent + '%';
    document.getElementById('barInterest').style.width = interestPercent + '%';
  }

  // పేజ్ లోడ్ అయిన వెంటనే ఆటోమేటిక్‌గా ఫలితాలు చూపడానికి
  window.onload = calculateGlobalEMI;
</script>
